{
  "comment": "Same source, one codebase per env. Firebase joins prefix as `${prefix}-${exportName}` (qual + syncData → qual-syncData). Hosting rewrites must use the prefixed functionId. Pair with APP_ENV + per-env serviceAccount on deploy.",
  "functions": [
    {
      "source": "functions",
      "codebase": "prod",
      "prefix": "prod",
      "configDir": "functions/config/prod",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "**/functions.pinned.qual.example.ts"
      ]
    },
    {
      "source": "functions",
      "codebase": "qual",
      "prefix": "qual",
      "configDir": "functions/config/qual",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "**/functions.pinned.qual.example.ts"
      ]
    }
  ],
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.prod.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "qual-env",
      "rules": "firestore.qual.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "target": "prod",
      "public": "dist",
      "rewrites": [
        {
          "source": "/api/**",
          "function": { "functionId": "prod-api", "codebase": "prod" }
        }
      ]
    },
    {
      "target": "qual",
      "public": "dist",
      "rewrites": [
        {
          "source": "/api/**",
          "function": { "functionId": "qual-api", "codebase": "qual" }
        }
      ]
    }
  ],
  "storage": [
    {
      "bucket": "myapp-prod.appspot.com",
      "rules": "storage.prod.rules"
    },
    {
      "bucket": "myapp-qual.appspot.com",
      "rules": "storage.qual.rules"
    }
  ]
}
